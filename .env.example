# PostgreSQL connection URL. Obtain the real value from the store's authorized environment.
# Example format only: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=

# Runtime direct URL (if required): same least-privilege app role and database.
# Keep migration-owner credentials outside the Vercel runtime.
DIRECT_URL=

# iron-session password: use a randomly generated value of at least 32 characters.
# Example generator: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# UUID provisioned only for a dedicated non-production integration-test database.
# Tests also require the matching DatabaseTestMarker row in that database.
DB_TEST_ENVIRONMENT_ID=

# Hosted deployment requires exact HTTPS origin; local development may leave blank.
APP_ORIGIN=
# Hosted production: production; hosted non-production: preview/test/development.
DATABASE_ENVIRONMENT=development
# Hostname only. Set the same production pin in production and preview environments.
PRODUCTION_DATABASE_HOST=
# Runtime role must match DATABASE_URL (and DIRECT_URL, if supplied). Never the owner.
APP_DATABASE_ROLE=
# Remote URLs require sslmode=require&sslaccept=strict for Prisma v6.
# Management MFA is not implemented yet: Vercel production startup remains blocked.
