# PostgreSQL connection URL. Obtain the real value from the store's authorized environment.
# Example format only: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=

# Optional: separate migration connection URL for managed PostgreSQL providers.
DIRECT_URL=

# iron-session password: use a randomly generated value of at least 32 characters.
# Example generator: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# UUID provisioned only for a dedicated non-production integration-test database.
# Tests also require the matching DatabaseTestMarker row in that database.
DB_TEST_ENVIRONMENT_ID=
