{
    "name": "mahjong-store-system",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test:auth": "vitest run src/lib/auth/auth.test.ts",
        "test": "vitest run",
        "test:customers": "vitest run src/features/customers/customer-management.test.ts",
        "db:generate": "prisma generate",
        "db:validate": "node scripts/db-validate.mjs",
        "db:migrate": "prisma migrate dev",
        "db:create-owner": "node scripts/create-owner.mjs",
        "security:check": "npm audit --audit-level=low"
    },
    "dependencies": {
        "@prisma/client": "6.19.3",
        "bcryptjs": "^3.0.3",
        "iron-session": "^9.0.1",
        "next": "16.4.3",
        "react": "19.1.1",
        "react-dom": "19.1.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.3.3",
        "@types/node": "22.19.1",
        "@types/react": "19.2.2",
        "@types/react-dom": "19.2.2",
        "eslint": "9.39.5",
        "eslint-config-next": "16.4.3",
        "prisma": "6.19.3",
        "tailwindcss": "4.3.3",
        "typescript": "5.9.3",
        "vitest": "^5.0.3"
    },
    "overrides": {
        "@prisma/config@6.19.3": {
            "deepmerge-ts": "8.0.0"
        }
    }
}
